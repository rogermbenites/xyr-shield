# NEAR AI Cloud (cloud.near.ai → API keys)
NEARAI_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8   # must be a TEE-attested model; the node refuses others

# Chain: local (offline hash chain in data/) or near
SHIELD_CHAIN=local
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=                        # e.g. my-shield.testnet
NEAR_PRIVATE_KEY=                       # ed25519:...
SHIELD_CONTRACT=                        # defaults to NEAR_ACCOUNT_ID
SHIELD_DATA=                            # optional: separate data dir per instance

# API auth
SHIELD_API_KEYS=demo                    # comma-separated buyer keys
SHIELD_ADMIN_KEY=                       # owner key: /reveal, /demo-record

# Hyperliquid TESTNET executor — trades each record, vaults the fill
SHIELD_EXEC=off
HL_ACCOUNT_ADDRESS=                     # wallet holding the testnet USDC
HL_AGENT_KEY=                           # API/agent wallet private key
HL_SIZE=0.0002                          # BTC per position

# R oracle
RNODE_ANCHOR_S=300                      # anchor the chain head on NEAR every N seconds
RNODE_MODEL=                            # private model, e.g. my_pkg.r:MyR (default: public RSI stand-in)
RNODE_SOURCE=                           # private bar source (default: Binance 1m candles)
